@startuml
!include _style.iuml
title Sequence Diagram: Delete Reservation (DELETE /api/v1/reservations/:id)\nUser: own only / Admin: any

actor "Client\n(Postman)" as client
participant "<<javaScript>>\n:server" as server
participant "<<router>>\n:reservations" as router
participant "<<middleware>>\n:auth" as auth
participant "<<controllers>>\n:reservations" as ctrl
participant "<<model>>\n:Reservation" as model
database "<<MongoDB>>\n:reservations" as db

client -> server ++ : req.delete('/api/v1/reservations/:id')\nAuthorization: Bearer token
server -> router ++ : app.use('/api/v1/reservations', reservations)
router -> auth ++ : protect, authorize('admin', 'user')
auth --> router -- : req.user
router -> ctrl ++ : deleteReservation
ctrl -> model ++ : findById(id)
model -> db ++ : ReservationSchema
db --> model -- : reservation
model --> ctrl -- : reservation
alt not found
  ctrl --> client : 404 No reservation with the id
else not the owner and not admin
  ctrl --> client : 401 User ... is not authorized\nto delete this reservation
else owner or admin
  ctrl -> model ++ : reservation.deleteOne()
  model -> db ++ : ReservationSchema
  db --> model -- : deleted
  model --> ctrl -- : done
  ctrl --> client : 200 {success:true, data:{}}
end
deactivate ctrl
deactivate router
deactivate server
@enduml
