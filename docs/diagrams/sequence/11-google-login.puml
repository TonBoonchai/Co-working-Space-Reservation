@startuml
!include _style.iuml
title Sequence Diagram: User Log-in with Google\n(GET /api/v1/auth/google, GET /api/v1/auth/google/callback)

actor "Client\n(Browser)" as client
participant "<<javaScript>>\n:server" as server
participant "<<router>>\n:auth" as router
participant "<<controllers>>\n:auth" as ctrl
participant "<<external>>\n:Google" as google
participant "<<model>>\n:User" as model
database "<<MongoDB>>\n:users" as db

== Start ==
client -> server ++ : req.get('/api/v1/auth/google')
server -> router ++ : app.use('/api/v1/auth', auth)
router -> ctrl ++ : googleLogin
alt GOOGLE_* not set in config.env
  ctrl --> client : 503 {success:false,\nmessage: "Google login is not configured"}
else
  ctrl -> ctrl : random state + PKCE verifier
  ctrl --> client : 302 Location: Google consent page\n+ httpOnly googleOAuth cookie (state, verifier)
end
deactivate ctrl
deactivate router
deactivate server

client -> google ++ : user picks a Google account and agrees
google --> client -- : 302 Location: /api/v1/auth/google/callback?code&state

== Callback ==
client -> server ++ : req.get('/api/v1/auth/google/callback?code&state')\n+ googleOAuth cookie
server -> router ++ : app.use('/api/v1/auth', auth)
router -> ctrl ++ : googleCallback
ctrl -> ctrl : clear googleOAuth cookie
alt no cookie, or state does not match
  ctrl --> client : 400 {success:false,\nmessage: "Invalid or expired Google login. Please start again"}
else user cancelled (error) or no code
  ctrl --> client : 400 {success:false, message: "Google login was cancelled"}
else
  ctrl -> google ++ : POST token endpoint\n{code, code_verifier, client_id, client_secret}
  google --> ctrl -- : access_token
  ctrl -> google ++ : GET userinfo\nAuthorization: Bearer access_token
  google --> ctrl -- : {sub, email, email_verified, name}
  alt Google rejects a request
    ctrl --> client : 401 {success:false, message: "Google rejected the login"}
  else email not verified
    ctrl --> client : 401 {success:false,\nmessage: "The Google account has no verified email"}
  else
    ctrl -> model ++ : findOne({googleId: sub})
    model -> db ++ : UserSchema
    db --> model -- : user
    model --> ctrl -- : user
    opt first Google login (no user)
      ctrl -> model ++ : exists({email})
      model --> ctrl -- : registered
      alt email registered with a password
        ctrl --> client : 409 {success:false,\nmessage: "This email is already registered.\nPlease log in with your password"}
      else
        ctrl -> model ++ : create({name, email, googleId: sub})
        model -> db ++ : UserSchema
        db --> model -- : user
        model --> ctrl -- : user
      end
    end
    ctrl -> ctrl : sendTokenResponse(user, 200)\ngetSignedJwtToken()
    ctrl --> client : 200 {success:true, ..., token}\n+ httpOnly token cookie
  end
end
deactivate ctrl
deactivate router
deactivate server
@enduml
