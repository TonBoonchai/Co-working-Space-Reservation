@startuml
!include _style.iuml
title Sequence Diagram: User / Admin Log-out (GET /api/v1/auth/logout)

actor "Client\n(Postman)" as client
participant "<<javaScript>>\n:server" as server
participant "<<router>>\n:auth" as router
participant "<<controllers>>\n:auth" as ctrl

client -> server ++ : req.get('/api/v1/auth/logout')
server -> router ++ : app.use('/api/v1/auth', auth)
router -> ctrl ++ : logout
ctrl -> ctrl : res.cookie('token', 'none',\n{expires: now + 10s, httpOnly: true})
ctrl --> client : 200 {success:true, data:{}}
deactivate ctrl
deactivate router
deactivate server

note over client
  Postman test script sets TOKEN = null,
  so the next GET /api/v1/auth/me is
  rejected with 401 (logged out).
end note
@enduml
