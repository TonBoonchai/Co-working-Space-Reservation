@startuml
!include _style.iuml
title Sequence Diagram: User Join Waitlist\n(POST /api/v1/coworkingspaces/:coworkingSpaceId/waitlist)

actor "Client\n(Postman)" as client
participant "<<javaScript>>\n:server" as server
participant "<<router>>\n:coworkingspaces" as spaceRouter
participant "<<router>>\n:waitlist" as router
participant "<<middleware>>\n:auth" as auth
participant "<<controllers>>\n:waitlist" as ctrl
participant "<<model>>\n:CoworkingSpace" as spaceModel
participant "<<model>>\n:Reservation" as resvModel
participant "<<model>>\n:Closure" as closureModel
participant "<<model>>\n:WaitlistEntry" as model
database "<<MongoDB>>\n:coworkingspaces" as spaceDb
database "<<MongoDB>>\n:reservations" as resvDb
database "<<MongoDB>>\n:closures" as closureDb
database "<<MongoDB>>\n:waitlistentries" as db

client -> server ++ : req.post('/api/v1/coworkingspaces/:coworkingSpaceId/waitlist')\nAuthorization: Bearer token\n{startTime, endTime}
server -> spaceRouter ++ : app.use('/api/v1/coworkingspaces', coworkingspaces)
spaceRouter -> router ++ : router.use('/:coworkingSpaceId/waitlist', waitlistRouter)
router -> auth ++ : protect, authorize('admin', 'user')
auth --> router -- : req.user
router -> ctrl ++ : addWaitlistEntry
ctrl -> spaceModel ++ : findById(coworkingSpaceId)
spaceModel -> spaceDb ++ : CoworkingSpaceSchema
spaceDb --> spaceModel -- : coworkingSpace
spaceModel --> ctrl -- : coworkingSpace
alt co-working space not found
  ctrl --> client : 404 No co-working space with the id
else space found
  ctrl -> ctrl : checkReservationTime(startTime, endTime, coworkingSpace)
  ctrl -> resvModel ++ : countDocuments({user})
  resvModel -> resvDb ++ : ReservationSchema
  resvDb --> resvModel -- : count
  resvModel --> ctrl -- : count
  alt time not allowed, or user at the reservation limit
    ctrl --> client : 400 {success:false, message: reason}
  else input OK
    group one transaction with the space lock
      ctrl -> closureModel ++ : findOne(overlapFilter(coworkingSpace,\nstartTime, endTime))
      closureModel -> closureDb ++ : ClosureSchema
      closureDb --> closureModel -- : closure / null
      closureModel --> ctrl -- : closure / null
      ctrl -> resvModel ++ : find(overlapFilter(coworkingSpace,\nstartTime, endTime))
      resvModel -> resvDb ++ : ReservationSchema
      resvDb --> resvModel -- : overlapping reservations
      resvModel --> ctrl -- : overlapping reservations
      ctrl -> ctrl : peakOverlap(reservations, startTime, endTime)
      ctrl -> model ++ : exists(overlapFilter(coworkingSpace,\nstartTime, endTime), user)
      model -> db ++ : WaitlistEntrySchema
      db --> model -- : entry / null
      model --> ctrl -- : entry / null
    end
    alt closure overlaps the period
      ctrl --> client : 400 "<space> is closed from\n<start> to <end> (<reason>)"
    else peak < coworkingSpace.capacity
      ctrl --> client : 400 "<space> is not full from <start>\nto <end>, so please make a reservation"
    else user already has an overlapping entry
      ctrl --> client : 400 "You already have a waitlist entry\nat this space that overlaps this period"
    else space full
      ctrl -> model ++ : create({startTime, endTime,\nuser, coworkingSpace})
      model -> db ++ : WaitlistEntrySchema
      db --> model -- : entry
      model --> ctrl -- : entry
      ctrl --> client : 201 {success:true, data: entry}
    end
  end
end
deactivate ctrl
deactivate router
deactivate spaceRouter
deactivate server
@enduml
