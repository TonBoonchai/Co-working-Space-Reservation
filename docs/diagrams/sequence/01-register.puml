@startuml
!include _style.iuml
title Sequence Diagram: User Register (POST /api/v1/auth/register)

actor "Client\n(Postman)" as client
participant "<<javaScript>>\n:server" as server
participant "<<router>>\n:auth" as router
participant "<<controllers>>\n:auth" as ctrl
participant "<<model>>\n:User" as model
database "<<MongoDB>>\n:users" as db

client -> server ++ : req.post('/api/v1/auth/register')\n{name, tel, email, password, role}
server -> router ++ : app.use('/api/v1/auth', auth)
router -> ctrl ++ : register
ctrl -> model ++ : create({name, tel, email, password, role})
model -> model : validate (required fields,\nThai tel format, email format)
alt invalid data
  model --> ctrl : ValidationError
  ctrl --> client : 400 {success:false,\nmessage: "Please add a valid Thai telephone number ..."}
else valid data
  model -> model : pre('save'): bcrypt hash password
  model -> db ++ : UserSchema
  alt email already registered
    db --> model : duplicate key (E11000)
    model --> ctrl : error
    ctrl --> client : 400 {success:false,\nmessage: "This email is already registered"}
  else new email
    db --> model -- : user
    model --> ctrl -- : user
    ctrl -> ctrl : sendTokenResponse(user, 201)\ngetSignedJwtToken()
    ctrl --> client : 201 {success:true, _id, name, tel,\nemail, role, token} + token cookie
  end
end
deactivate ctrl
deactivate router
deactivate server
@enduml
