          "name": "0006 Alice Gets Ended Reservation",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Wait until the short reservation ends (no wait when it already ended)",
                  "const waitMs = Math.max(0, new Date(pm.collectionVariables.get(\"shortEnd\")) - Date.now() + 1000);",
                  "setTimeout(() => {}, waitMs);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", () => pm.response.to.have.status(200));",
