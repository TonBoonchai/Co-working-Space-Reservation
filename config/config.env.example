PORT=5050
NODE_ENV=development

# MongoDB Atlas connection string (database name: coworking)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster-host>/coworking?appName=<cluster-name>

JWT_SECRET=<any long random string>
JWT_EXPIRE=30d
JWT_COOKIE_EXPIRE=30

# Google login (OAuth 2.0). Create an OAuth client of type "Web application" in
# Google Cloud Console, and add GOOGLE_CALLBACK_URL as an authorized redirect URI.
GOOGLE_CLIENT_ID=<client id>
GOOGLE_CLIENT_SECRET=<client secret>
GOOGLE_CALLBACK_URL=http://localhost:5050/api/v1/auth/google/callback
