PORT=5050
NODE_ENV=development

# MongoDB Atlas connection string (database name: coworking)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster-host>/coworking?appName=<cluster-name>

JWT_SECRET=<any long random string>
JWT_EXPIRE=30d
JWT_COOKIE_EXPIRE=30

# SMTP server for the emails to users: a closure canceled their reservation,
# an admin changed or deleted their reservation, or their waitlist entry became
# a reservation. When SMTP_HOST is empty, the server writes each email to the
# console and does not send it.
SMTP_HOST=
SMTP_PORT=587
SMTP_EMAIL=
SMTP_PASSWORD=
FROM_NAME=Co-working Space Reservation
FROM_EMAIL=noreply@coworking.local
